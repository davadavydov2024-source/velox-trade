# Скопируй этот файл в .env и заполни теми же значениями, что и в .env.local сайта.

# Токен бота из @BotFather (Telegram → @BotFather → /mybots → выбрать бота → API Token)
TELEGRAM_BOT_TOKEN=

# Личный chat_id администратора в Telegram (не UID сайта) — сюда бот шлёт заявки на пополнение/вывод,
# сообщения в поддержку и запросы на сотрудничество.
TELEGRAM_ADMIN_CHAT_ID=

# Необязательно: ссылка на Telegram-канал сайта (кнопка "📢 Наш канал" в главном меню)
TELEGRAM_CHANNEL_URL=

# Название сайта, которое бот подставляет в тексты меню
SITE_NAME=Velox Trade

# --- Firebase Admin — те же 3 значения, что в .env.local сайта ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
