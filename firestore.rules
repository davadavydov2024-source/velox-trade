rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ───────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ─── users ─────────────────────────────────────────────────────────────────
    // Публичные поля (displayName, photoURL, bio, username, ratingSum, ratingCount)
    // читают все — нужно для страницы продавца, чата, каталога.
    match /users/{uid} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── usernames (резервирование ников) ──────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ─── products ──────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuth();
      // Редактировать может только продавец-владелец или админ
      allow update: if isAuth() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuth() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // ─── orders ────────────────────────────────────────────────────────────────
    // ГЛАВНЫЙ БАГ: продавец не мог читать заказ → чат не открывался
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      // Создание и изменение только через serverless API (Admin SDK обходит правила)
      allow create: if false;
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ─── orderChats ────────────────────────────────────────────────────────────
    match /orderChats/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ─── disputes ──────────────────────────────────────────────────────────────
    match /disputes/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── reviews ───────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── pushSubscriptions ─────────────────────────────────────────────────────
    match /pushSubscriptions/{docId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ─── notifications ─────────────────────────────────────────────────────────
    match /notifications/{docId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── tickets (поддержка) ───────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow delete: if false;
    }

    // ─── payments / topups ─────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow write: if false; // только через API
    }
    match /topups/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    // ─── promoCodes ────────────────────────────────────────────────────────────
    match /promoCodes/{codeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── sellRequests ──────────────────────────────────────────────────────────
    match /sellRequests/{docId} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── productEditRequests ───────────────────────────────────────────────────
    match /productEditRequests/{docId} {
      allow read: if isAuth() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── sessions ──────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── favorites ─────────────────────────────────────────────────────────────
    match /favorites/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // ─── priceHistory ──────────────────────────────────────────────────────────
    match /priceHistory/{docId} {
      allow read: if true;
      allow write: if false; // только через Admin SDK
    }

    // ─── stats (публичный счётчик сделок) ─────────────────────────────────────
    match /stats/{docId} {
      allow read: if true;
      allow write: if false; // только через Admin SDK
    }

    // ─── siteReviews / siteScreens / newsPosts / ads ──────────────────────────
    match /siteReviews/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteScreens/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /newsPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── events / games / wheelPrizes ─────────────────────────────────────────
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /games/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /wheelPrizes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── mail (Firebase Email Extension) ──────────────────────────────────────
    match /mail/{docId} {
      allow read: if false;
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ─── всё остальное — запрещено ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
