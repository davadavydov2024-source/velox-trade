rules_version = '2';

// Firebase Storage на сайте НЕ используется (картинки лежат в Vercel Blob через /api/blob/upload),
// поэтому закрываем его полностью: раньше любой вошедший мог писать/перезаписывать файлы в avatars/.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
